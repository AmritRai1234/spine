# Admin panel key (full access). Required.
ADMIN_SECRET=sk_admin_secret_change_me

# Staff fulfilment key (orders only: status updates + restock). Optional.
STAFF_SECRET=sk_staff_secret_change_me

# Server bind
SPINE_PORT=8080
SPINE_DB=spine.db

# Max HTTP request body (bytes). Product images are stored in-row as data
# URLs, so publishing a product with a 4-image gallery needs ~2-4 MB.
# Default (unset) is 1 MB — fail-closed.
SPINE_MAX_BODY_BYTES=4194304

# Stripe (test mode only — never commit live keys)
# Webhook endpoint: POST /webhook/stripe
STRIPE_SECRET=

# WebSocket origins allowed to connect (deny-by-default — must be FULL origins,
# e.g. http://localhost:5173; comma-separated; "*" allows all). Needed for the
# storefront dashboard's live badge/updates in dev.
SPINE_WS_ORIGINS=http://localhost:5173

# Credentialed CORS allowlist (comma-separated full origins). Unset = wildcard
# origin WITHOUT credentials (browser CORS for direct /emit calls).
SPINE_CORS_ORIGINS=

# New-order notifications: any HTTP endpoint receiving a JSON POST. Optional.
ALERT_WEBHOOK_URL=
