# Production build config — the spine server serves the built SPA + the API
# on ONE port (see engine: serves web/dist from CWD). Empty SPINE_URL makes
# the client same-origin: /emit, /tables and /ws resolve on the current host.
SPINE_URL=

# Optional: set to the storefront (shopper) key declared in app.spine to
# enable live WebSocket broadcasts in production. Leave empty for HTTP-only
# pages (the live badge will read "offline"; everything else works).
SPINE_API_KEY=
