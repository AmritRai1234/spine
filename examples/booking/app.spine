spine_version: 3

database:
  tables:
    - slots
    - bookings
    - cancellations

# Deliberate mixed node forms: "Booking" is LIST-FORM — live proof of the
# 2026-09-01 parser fix (list-form nodes were silently ignored, zeroing
# schema.Nodes and disabling ALL contract validation). With the fix, its
# payload types (capacity: integer) attach correctly AND route→emits
# validation is active. "Reminders" stays map-form; both parse identically.
nodes:
  - name: Booking
    emits:
      - event: SLOTS_TICK
      - event: BOOK_SLOT
        payload:
          slot_id: string
          customer_email: string
      - event: CANCEL_BOOKING
        payload:
          booking_id: string
          slot_id: string
    listens:
      - state: BOOKING_CONFIRMED
        payload:
          slot_id: string
          customer_email: string
      - state: SLOT_UNAVAILABLE
        payload:
          slot_id: string
          reason: string

  Reminders:
    emits:
      - event: REMINDER_TICK
    listens:
      - state: BOOKING_DUE
        payload:
          customer_email: string
          slot_id: string

routes:
  # Slot generation — the cron produces bookable slots from business hours.
  # Deterministic ids make nightly re-runs idempotent; capacity is NEVER
  # reset on existing rows (booked seats stay claimed); schedule changes
  # never delete previously generated slots (cleanup is an explicit
  # business route, not a cron side effect).
  - on: SLOTS_TICK
    cron: 86400s
    steps:
      - action: slots.generate
        table: slots
        days_ahead: 30
        weekdays: "mon-sat"
        open: "09:00"
        close: "17:00"
        duration_minutes: 60
        capacity: 4

  # Claim: atomic seat claim (db.adjust floor guard, synchronous), then the
  # composite upsert enforces one booking per customer per slot.
  #
  # on_failure lane discipline:
  #   - adjust floor-rejects  → route-level SLOT_UNAVAILABLE (seat never
  #     taken; NO compensation — compensating here hands out seats nobody
  #     held; this exact bug was caught by the race tests)
  #   - upsert conflicts      → step-level RELEASE_SEAT (seat WAS taken;
  #     capacity restored synchronously, then customer-facing failure state)
  - on: BOOK_SLOT
    on_failure: SLOT_UNAVAILABLE
    steps:
      - action: db.adjust
        table: slots
        where: "id = $event.payload.slot_id"
        column: capacity
        by: -1
        floor: 0
      - action: db.lookup
        table: slots
        key_column: id
        value_expr: $event.payload.slot_id
        as: slot_
      - action: set
        id: $uuid
        created_at: $now
        status: confirmed
        # Real reminder scheduling: 24h before the slot's start time.
        # Math on the looked-up start happens via the reminder fanout's own
        # due logic — here we store the slot start; the REMINDER_TICK where
        # compares against it with a lead-time offset computed by the
        # caller (see REMINDER_TICK comment).
        reminder_due: $event.payload.slot_start_time
      - action: db.upsert
        table: bookings
        on_failure: RELEASE_SEAT
        key:
          - slot_id
          - customer_email
    emit: BOOKING_CONFIRMED

  # Compensation: upsert conflicted AFTER the seat was claimed → give it back.
  # db.adjust runs synchronously on the DB pool, so the freed seat is visible
  # to the next booker immediately after this chain completes.
  - on: RELEASE_SEAT
    steps:
      - action: db.adjust
        table: slots
        where: "id = $event.payload.slot_id"
        column: capacity
        by: 1
    emit: SLOT_UNAVAILABLE

  # Cancel: verify-then-reverse. The compensating adjust must only fire for
  # a booking transitioning confirmed -> cancelled — never for one that is
  # already cancelled (a blind adjust mints phantom seats: double-cancel
  # restored capacity twice in the 2026-09-01 stress test).
  #
  # The race-safe guard is the SAME composite-claim pattern as BOOK_SLOT:
  # the cancellations table's composite key (booking_id) makes "cancel this
  # booking" itself an atomic claim. The db.upsert runs synchronously and
  # rejects on conflict BEFORE the capacity adjust runs, so 20 simultaneous
  # cancels yield exactly one capacity restore. db.lookup + assert keep the
  # loud failure lane (reject into ALREADY_CANCELLED, never a silent no-op)
  # and give a precise error message; the composite upsert is what makes it
  # race-proof. The db.update status flip stays cosmetic/batched — capacity
  # is the guarantee, status may lag.
  - on: CANCEL_BOOKING
    on_failure: ALREADY_CANCELLED
    steps:
      - action: db.lookup
        table: bookings
        key_column: id
        value_expr: $event.payload.booking_id
        as: booking_
      - action: assert
        condition: "$event.payload.booking_status == 'confirmed'"
        message: "booking is not cancellable (current status: $event.payload.booking_status)"
      - action: db.upsert
        table: cancellations
        on_failure: ALREADY_CANCELLED
        key:
          - booking_id
      - action: db.update
        table: bookings
        where: "id = $event.payload.booking_id"
      - action: db.adjust
        table: slots
        where: "id = $event.payload.slot_id"
        column: capacity
        by: 1
    emit: BOOKING_CANCELLED

  # Reminder sweep — rides the existing db.fanout primitive. reminder_due
  # now holds the SLOT'S START TIME (copied from the slot row at booking
  # time via db.lookup), so the scan fires for bookings whose slot starts
  # within the next 24h — a real 24h-before reminder. The `where` bound is
  # $now + 24h expressed as the fanout threshold: rows due (start <= now+24h)
  # fire BOOKING_DUE. cron runs hourly, so reminders arrive within the hour
  # of the 24h mark.
  - on: REMINDER_TICK
    cron: 3600s
    steps:
      - action: db.fanout
        table: bookings
        where: "reminder_due <= $now"
        emit_event: BOOKING_DUE
        due_column: reminder_due
        interval_column: created_at
