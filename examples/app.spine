# app.spine
spine_version: 1

database:
  tables:
    - users
    - accounts
    - landing_analytics
    - projects
    - clips
    - transcripts
    - blackboard_events

nodes:
  LandingPage:
    owns_files:
      - frontend/src/pages/LandingPage.tsx
      - frontend/src/pages/LandingPage.styles.css
    emits:
      - event: SUBMIT_LEAD
        payload:
          email: string
    listens:
      - state: LEAD_STATUS
        payload:
          status: string

  AccountPage:
    owns_files:
      - frontend/src/pages/AccountPage.tsx
    emits:
      - event: UPDATE_PROFILE
        payload:
          name: string
          avatar: string
    listens:
      - state: USER_PROFILE
        payload:
          name: string
          avatar: string
          role: string

  Dashboard:
    owns_files:
      - frontend/src/pages/Dashboard.tsx
    emits:
      - event: CREATE_PROJECT
        payload:
          title: string
          source_url: string
    listens:
      - state: PROJECT_CREATED
        payload:
          project_id: string
          status: string

  ProjectView:
    owns_files:
      - frontend/src/pages/ProjectView.tsx
    emits:
      - event: START_PIPELINE
        payload:
          project_id: string
    listens:
      - state: PIPELINE_PROGRESS
        payload:
          project_id: string
          stage: string
          progress: number
          message: string

  ClipEditor:
    owns_files:
      - frontend/src/pages/ClipEditor.tsx
    emits:
      - event: UPDATE_CLIP_STYLE
        payload:
          clip_id: string
          font_family: string
          font_color: string
    listens:
      - state: CLIP_UPDATED
        payload:
          clip_id: string
          status: string

  BlackboardPipeline:
    owns_files:
      - backend/pipeline/blackboard.py
      - backend/pipeline/orchestrator.py
    emits:
      - event: PIPELINE_PROGRESS
        payload:
          project_id: string
          stage: string
          progress: number
          message: string
    listens:
      - state: START_PIPELINE
        payload:
          project_id: string

routes:
  - "on": SUBMIT_LEAD
    steps:
      - action: db.insert
        table: landing_analytics
        input: "$event.payload"
    emit: LEAD_STATUS

  - "on": UPDATE_PROFILE
    steps:
      - action: db.update
        table: users
        input: "$event.payload"
    emit: USER_PROFILE

  - "on": CREATE_PROJECT
    steps:
      - action: db.insert
        table: projects
        input: "$event.payload"
    emit: PROJECT_CREATED

  - "on": START_PIPELINE
    steps:
      - action: pipeline.dispatch_blackboard
        input: "$event.payload"
    emit: PIPELINE_PROGRESS

  - "on": UPDATE_CLIP_STYLE
    steps:
      - action: db.update
        table: clips
        input: "$event.payload"
    emit: CLIP_UPDATED
