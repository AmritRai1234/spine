# app.spine
spine_version: 1

database:
  tables:
    - users
    - accounts
    - landing_analytics
    - projects
    - clips
    - transcripts
    - blackboard_events
    - audit_logs

nodes:
  LandingPage:
    owns_files:
      - frontend/src/pages/LandingPage.tsx
      - frontend/src/pages/LandingPage.styles.css
    emits:
      - event: SUBMIT_LEAD
        payload:
          email: string
    listens:
      - state: LEAD_STATUS
        payload:
          status: string

  AccountPage:
    owns_files:
      - frontend/src/pages/AccountPage.tsx
    emits:
      - event: UPDATE_PROFILE
        payload:
          name: string
          role: string
          email: string
    listens:
      - state: USER_PROFILE
        payload:
          name: string
          role: string
          email: string

  Dashboard:
    owns_files:
      - frontend/src/pages/Dashboard.tsx
    emits:
      - event: CREATE_PROJECT
        payload:
          title: string
          source_url: string
      - event: PROCESS_PIPELINE
        payload:
          project_id: string
          progress: int
          score: float
          duration: float
          segment_count: int
    listens:
      - state: PROJECT_CREATED
        payload:
          project_id: string
          status: string
      - state: PROCESSING_FAILED
        payload:
          error: string
          failed_action: string

routes:
  # Submit Lead Route (with parallel execution)
  - on: SUBMIT_LEAD
    parallel: true
    steps:
      - action: db.insert
        table: landing_analytics
        input: "$event.payload"

      - action: log.write
        message: "[LEAD] Received lead for $event.payload.email at $now"

    emit: LEAD_STATUS

  - on: LEAD_STATUS
    steps:
      - action: log.write
        message: "[AUDIT] Lead status processed successfully"

  # Admin Update Profile Route (with conditional route guard)
  - on: UPDATE_PROFILE
    if: "$event.payload.role == 'admin'"
    steps:
      - action: db.update
        table: users
        input: "$event.payload"
      - action: log.write
        message: "[SECURITY] Admin profile updated for $event.payload.name"
    emit: USER_PROFILE

  # Create Project Route
  - on: CREATE_PROJECT
    steps:
      - action: db.insert
        table: projects
        input: "$event.payload"
    emit: PROJECT_CREATED

  # Pipeline Processing Route (with error route on failure)
  - on: PROCESS_PIPELINE
    on_failure: PROCESSING_FAILED
    steps:
      - action: pipeline.run
        timeout_sec: 30
      - action: db.insert
        table: clips

  - on: PROCESSING_FAILED
    steps:
      - action: db.insert
        table: audit_logs
      - action: log.write
        message: "[ERROR] Pipeline failed: $event.payload.error"
